PSP_EXPORT_END

# 0x4001: callable from user mode via syscall.
PSP_EXPORT_START(thkcore, 0, 0x4001)
PSP_EXPORT_FUNC(thkGetApiVersion)
PSP_EXPORT_FUNC(thkGetHookState)
PSP_EXPORT_FUNC(thkGetTitleId)
PSP_EXPORT_FUNC(thkOverlayShow)
PSP_EXPORT_FUNC(thkOverlayConfig)
PSP_EXPORT_FUNC(thkOverlayHide)
PSP_EXPORT_FUNC(thkNetModules)
PSP_EXPORT_FUNC(thkMemInfo)
PSP_EXPORT_FUNC(thkPopupShow)
PSP_EXPORT_FUNC(thkPopupFrame)
PSP_EXPORT_FUNC(thkEventRange)
PSP_EXPORT_FUNC(thkEventGet)
# Not imported by anything: the hook stubs (capture.c) make its syscall.
PSP_EXPORT_FUNC(thkHookEntry)
PSP_EXPORT_END

PSP_END_EXPORTS
